# Copy to .env.local. Every setting is optional.

# ---- Claude sign-in ----
# Default: agents run on your Claude Code login (your Pro/Max subscription, via OAuth).
# Sign in once with the Claude Code CLI (`claude`, then /login). Aviator never reads or
# copies your token; the Claude Code engine uses and refreshes it itself.
AVIATOR_AUTH=claude-code

# Headless machine with no Keychain login? Create a long-lived subscription token with
# `claude setup-token` and paste it here.
CLAUDE_CODE_OAUTH_TOKEN=

# Pay-per-use API billing instead: set AVIATOR_AUTH=api-key and fill this in.
# (In claude-code mode this variable is removed from the agents' environment.)
ANTHROPIC_API_KEY=

# ---- ClickUp ----
# Lets Aviator fetch tasks by link or ID. Personal token: ClickUp > Settings > Apps.
CLICKUP_API_TOKEN=
# Only needed for custom task IDs like "DEV-123".
CLICKUP_TEAM_ID=

# ---- Aviator ----
# Where projects, runs and logs are stored (default: ./.aviator).
AVIATOR_DATA_DIR=
# 1 = scripted demo run that never calls Claude or touches git; for trying the UI.
AVIATOR_DEMO=
